# ==========================================
# LegalProp AI - .gitignore
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
*.env
.env
.env.local
.env.*.local
!.env.example

# --- Node / React / Frontend ---
node_modules/
dist/
build/
.npm/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Databases & Vector Stores ---
*.sqlite3
*.db
*.db-journal
*.sqlite
storage/vector_store/
chroma.sqlite3
backend/app/storage/vector_store/*
!backend/app/storage/vector_store/.gitkeep

# --- IDEs & OS Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Temporary & Scratch ---
*.log
tmp/
temp/
scratch/
