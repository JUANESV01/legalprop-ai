# ==========================================
# LegalProp AI - .gitignore
# ==========================================

# Backups y Archivos Comprimidos
*.zip
*.tar.gz
*.rar
*.bak

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Entornos Virtuales Python
.venv/
env/
venv/
ENV/

# Node.js & Frontend
node_modules/
frontend/node_modules/
.vite/
frontend/.vite/
frontend/dist/

# Bases de Datos y Almacén Vectorial (Persistencia local)
*.sqlite3
*.db
storage/vector_store/*
!storage/vector_store/.gitkeep
backend/storage/vector_store/*
!backend/storage/vector_store/.gitkeep
backend/app/storage/vector_store/*
!backend/app/storage/vector_store/.gitkeep

# Variables de Entorno y Secretos (Mantener .env.example)
*.env
.env
.env.local
.env.*.local
!.env.example

# Sistema Operativo y Editores
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.vscode/
.idea/
