# Configuración General
PROJECT_NAME="LegalProp AI"
ENVIRONMENT="development"
DEBUG=True

# Gemini API (Google GenAI)
GEMINI_API_KEY="tu_api_key_aqui"
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite"
# Cuota de embeddings (ítems por minuto). Súbela si tu clave tiene un plan de pago.
GEMINI_EMBEDDING_ITEMS_PER_MINUTE=84
MAX_CHUNKS_PER_DOCUMENT=400

# Grok AI (xAI API — opcional para modo multi-IA: Automático / Gemini / Grok)
XAI_API_KEY=""
# Nombre exacto de un modelo vigente de xAI (consúltalo en https://console.x.ai). Grok solo se activa si
# XAI_API_KEY y XAI_MODEL están definidos. Respaldos opcionales separados por comas:
XAI_MODEL=""
XAI_FALLBACK_MODELS=""

# Autenticación JWT
JWT_SECRET_KEY="cambia_esta_clave_secreta_en_produccion"
JWT_EXPIRATION_MINUTES=10080

# Persistencia (SQLite local o PostgreSQL en Render/Neon/Supabase: postgresql://user:pass@host:5432/db?sslmode=require)
DATABASE_URL="sqlite:///./legalprop.db"
CHROMA_PERSIST_DIR="./storage/vector_store"

# Cuenta Master (opcional: crea/sincroniza el usuario administrador maestro al arrancar)
MASTER_ADMIN_EMAIL=""
MASTER_ADMIN_PASSWORD=""
MASTER_ADMIN_NAME=""

# CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
